{
  "name": "@elonehoo/haul",
  "version": "0.0.8",
  "type": "module",
  "description": "convenient and modern wrapper around fetch with smart extensible defaults",
  "keywords": [
    "fetch"
  ],
  "license": "MIT",
  "author": "Elone Hoo <huchengyea@163.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/elonehoo/haul"
  },
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.cjs",
      "import": "./dist/index.mjs"
    },
    "./*": "./*"
  },
  "files": [
    "dist",
    "*.d.ts"
  ],
  "homepage": "https://github.com/elonehoo/haul#readme",
  "bugs": "https://github.com/elonehoo/haul/issues",
  "packageManager": "pnpm@12.18.0",
  "scripts": {
    "docs:dev": "pnpm -C docs run dev",
    "build": "rimraf dist && unbuild",
    "prepublishOnly": "pnpm run build",
    "release": "bumpp package.json core/package.json --commit --push --tag && pnpm -r publish --access public",
    "typeCheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest",
    "test:ui": "vitest --ui --open false",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@babel/eslint-parser": "8.1.2",
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.6",
    "@typescript/typescript6": "6.0.2",
    "@vitest/coverage-v8": "^5.1.0",
    "@vitest/ui": "^5.1.0",
    "bumpp": "12.3.0",
    "eslint": "10.15.0",
    "globals": "17.14.0",
    "pnpm": "12.18.0",
    "rimraf": "6.1.4",
    "typescript": "7.0.2",
    "unbuild": "^3.6.1",
    "vite": "8.3.8",
    "vitest": "5.1.0",
    "vitest-fetch-mock": "^0.4.5"
  }
}
